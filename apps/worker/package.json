{
  "name": "@ikun-q/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "better-auth": "1.7.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "7.0.2",
    "wrangler": "4.157.0"
  }
}
